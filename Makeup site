<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Makeup Store</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      background-color: #fdf6f9;
      color: #333;
    }

    nav {
      background-color: #ffe6f0;
      padding: 20px;
      text-align: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    nav h1 {
      font-size: 2em;
      margin-bottom: 10px;
    }

    nav ul {
      list-style: none;
      display: flex;
      justify-content: center;
      gap: 20px;
    }

    nav ul li a {
      text-decoration: none;
      color: #e91e63;
      font-weight: bold;
    }

    .container {
      padding: 40px;
      max-width: 1000px;
      margin: auto;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
    }

    .product {
      background-color: white;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-align: center;
    }

    .product img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
    }

    .product h3 {
      margin-top: 10px;
      color: #e91e63;
    }

    .product p {
      font-size: 0.9em;
      margin: 10px 0;
    }

    .product button {
      padding: 10px 20px;
      background-color: #e91e63;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: #ffe6f0;
      margin-top: 40px;
    }
  </style>
</head>
<body>

  <nav>
    <h1>Welcome to Our Makeup Store</h1>
    <ul>
      <li><a href="#">Home</a></li>
      <li><a href="#">Services</a></li>
    </ul>
  </nav>

  <div class="container">
    <h2>Featured Products</h2>
    <div class="products">
      <div class="product">
        <img src="https://via.placeholder.com/250x200?text=Lipstick" alt="Lipstick">
        <h3>Red Velvet Lipstick</h3>
        <p>Long-lasting vibrant color</p>
        <button>Add to Cart</button>
      </div>

      <div class="product">
        <img src="https://via.placeholder.com/250x200?text=Foundation" alt="Foundation">
        <h3>Glow Foundation</h3>
        <p>Flawless skin finish</p>
        <button>Add to Cart</button>
      </div>

      <div class="product">
        <img src="https://via.placeholder.com/250x200?text=Eyeliner" alt="Eyeliner">
        <h3>Jet Black Eyeliner</h3>
        <p>Precision waterproof line</p>
        <button>Add to Cart</button>
      </div>
    </div>
  </div>

  <footer>
    &copy; 2025 Makeup Store. All rights reserved.
  </footer>

</body>
